{
  "expo": {
    "name": "Restaurant Roulette",
    "slug": "celebration-roulette",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "celebrationroulette",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A4D2E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.visitcelebration.roulette"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A4D2E"
      },
      "package": "org.visitcelebration.roulette"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
